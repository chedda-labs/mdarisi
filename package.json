{
  "name": "mdarisi",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eval": "esbuild tools/eval/run.ts --bundle --platform=node --format=esm --packages=external --outfile=tools/eval/.build/run.mjs --log-level=warning && node tools/eval/.build/run.mjs",
    "eval:score": "node tools/eval/score.mjs",
    "pack": "node tools/pack-builder/build.mjs g7-sci --allow-drafts && esbuild tools/pack-builder/embed.ts --bundle --platform=node --format=esm --packages=external --outfile=tools/pack-builder/.build/embed.mjs --log-level=warning && node tools/pack-builder/.build/embed.mjs g7-sci"
  },
  "dependencies": {
    "@qvac/fabric-android-arm64": "0.22.0",
    "@qvac/fabric-ios": "0.22.0",
    "@qvac/sdk": "0.22.0",
    "bare-rpc": "^1.3.8",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "license": "UNLICENSED"
}
