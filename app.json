{
  "expo": {
    "name": "Mdarisi",
    "slug": "mdarisi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4D3B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mdarisi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "./plugins/withBundledModel",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Baloo2_600SemiBold.ttf",
            "./assets/fonts/Baloo2_700Bold.ttf",
            "./assets/fonts/Baloo2_800ExtraBold.ttf",
            "./assets/fonts/Nunito_400Regular.ttf",
            "./assets/fonts/Nunito_600SemiBold.ttf",
            "./assets/fonts/Nunito_700Bold.ttf",
            "./assets/fonts/Nunito_800ExtraBold.ttf",
            "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E4D3B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "backgroundColor": "#1E4D3B"
  }
}
